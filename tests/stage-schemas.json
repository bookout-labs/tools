{
  "triage": {
    "$defs": {
      "Seam": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Use the same short identifier in every slice that builds or uses this seam.",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "exists": {
            "description": "Set true for a seam that already exists in the checkout. Otherwise use false.",
            "title": "Exists",
            "type": "boolean"
          },
          "path": {
            "anyOf": [
              {
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "For an existing seam, give a workspace-relative file path. Otherwise use null.",
            "title": "Path"
          }
        },
        "required": [
          "name",
          "exists",
          "path"
        ],
        "title": "Seam",
        "type": "object"
      },
      "Slice": {
        "additionalProperties": false,
        "description": "One pull request's outcome, about 400 changed lines or fewer, and its proof obligations.",
        "properties": {
          "title": {
            "description": "Name the outcome.",
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          },
          "stateful": {
            "description": "Set true when the slice changes behavior across states or transitions.",
            "title": "Stateful",
            "type": "boolean"
          },
          "acceptance": {
            "description": "State how to check the outcome, including response and other behavior checks.",
            "pattern": "\\S",
            "title": "Acceptance",
            "type": "string"
          },
          "builds": {
            "description": "List interfaces, modules, and contracts this slice builds for other slices. Use an empty list when there are none.",
            "items": {
              "$ref": "#/$defs/Seam"
            },
            "title": "Builds",
            "type": "array"
          },
          "uses": {
            "description": "List seams this slice needs. Use an empty list when there are none.",
            "items": {
              "$ref": "#/$defs/Seam"
            },
            "title": "Uses",
            "type": "array"
          },
          "screen": {
            "description": "When the change alters a screen described under docs/screens/, name that Markdown file directly under docs/screens/ without '..'. Use an empty string when no documented screen changes.",
            "pattern": "^(docs/screens/(?:[^./\\\\\\x00-\\x1f]|\\.[^./\\\\\\x00-\\x1f])+\\.md)?$",
            "title": "Screen",
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SliceProperty"
            },
            "description": "List only named PostgreSQL CHECK, UNIQUE, FOREIGN KEY, EXCLUSION, or NOT NULL constraints. Use an empty list when the slice adds no database rule.",
            "title": "Properties"
          }
        },
        "required": [
          "title",
          "stateful",
          "acceptance",
          "builds",
          "uses",
          "screen",
          "properties"
        ],
        "title": "Slice",
        "type": "object"
      },
      "SliceProperty": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "State the database rule in plain words.",
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "constraint": {
            "description": "Give the exact PostgreSQL constraint name, such as deals_external_id_key.",
            "pattern": "\\S",
            "title": "Constraint",
            "type": "string"
          }
        },
        "required": [
          "name",
          "constraint"
        ],
        "title": "SliceProperty",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "human_question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "When this stage returns needs_human, put the question for the person here. Use null otherwise.",
        "title": "Human Question"
      },
      "work_kind": {
        "description": "Classify the work. Keep the inherited work_kind when the delivery state already has one for a slice.",
        "enum": [
          "feature",
          "bug_fix",
          "refactoring",
          "perf_issue"
        ],
        "title": "Work Kind",
        "type": "string"
      },
      "triage": {
        "description": "Use implement when the behavior is decided and the change fits in one pull request of about 400 changed lines or fewer. For other changes, use spec.",
        "enum": [
          "implement",
          "spec",
          "question",
          "needs_human"
        ],
        "title": "Triage",
        "type": "string"
      },
      "slice": {
        "anyOf": [
          {
            "$ref": "#/$defs/Slice"
          },
          {
            "type": "null"
          }
        ],
        "description": "For a parent issue that triages as implement, return its single slice. Use null otherwise, including for slice issues."
      }
    },
    "required": [
      "human_question",
      "work_kind",
      "triage",
      "slice"
    ],
    "title": "TriageOutput",
    "type": "object"
  },
  "research": {
    "additionalProperties": false,
    "properties": {
      "research": {
        "pattern": "\\S",
        "title": "Research",
        "type": "string"
      }
    },
    "required": [
      "research"
    ],
    "title": "ResearchOutput",
    "type": "object"
  },
  "spec": {
    "$defs": {
      "Seam": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Use the same short identifier in every slice that builds or uses this seam.",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "exists": {
            "description": "Set true for a seam that already exists in the checkout. Otherwise use false.",
            "title": "Exists",
            "type": "boolean"
          },
          "path": {
            "anyOf": [
              {
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "For an existing seam, give a workspace-relative file path. Otherwise use null.",
            "title": "Path"
          }
        },
        "required": [
          "name",
          "exists",
          "path"
        ],
        "title": "Seam",
        "type": "object"
      },
      "Slice": {
        "additionalProperties": false,
        "description": "One pull request's outcome, about 400 changed lines or fewer, and its proof obligations.",
        "properties": {
          "title": {
            "description": "Name the outcome.",
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          },
          "stateful": {
            "description": "Set true when the slice changes behavior across states or transitions.",
            "title": "Stateful",
            "type": "boolean"
          },
          "acceptance": {
            "description": "State how to check the outcome, including response and other behavior checks.",
            "pattern": "\\S",
            "title": "Acceptance",
            "type": "string"
          },
          "builds": {
            "description": "List interfaces, modules, and contracts this slice builds for other slices. Use an empty list when there are none.",
            "items": {
              "$ref": "#/$defs/Seam"
            },
            "title": "Builds",
            "type": "array"
          },
          "uses": {
            "description": "List seams this slice needs. Use an empty list when there are none.",
            "items": {
              "$ref": "#/$defs/Seam"
            },
            "title": "Uses",
            "type": "array"
          },
          "screen": {
            "description": "When the change alters a screen described under docs/screens/, name that Markdown file directly under docs/screens/ without '..'. Use an empty string when no documented screen changes.",
            "pattern": "^(docs/screens/(?:[^./\\\\\\x00-\\x1f]|\\.[^./\\\\\\x00-\\x1f])+\\.md)?$",
            "title": "Screen",
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SliceProperty"
            },
            "description": "List only named PostgreSQL CHECK, UNIQUE, FOREIGN KEY, EXCLUSION, or NOT NULL constraints. Use an empty list when the slice adds no database rule.",
            "title": "Properties"
          }
        },
        "required": [
          "title",
          "stateful",
          "acceptance",
          "builds",
          "uses",
          "screen",
          "properties"
        ],
        "title": "Slice",
        "type": "object"
      },
      "SliceProperty": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "State the database rule in plain words.",
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "constraint": {
            "description": "Give the exact PostgreSQL constraint name, such as deals_external_id_key.",
            "pattern": "\\S",
            "title": "Constraint",
            "type": "string"
          }
        },
        "required": [
          "name",
          "constraint"
        ],
        "title": "SliceProperty",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "human_question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "When this stage returns needs_human, put the question for the person here. Use null otherwise.",
        "title": "Human Question"
      },
      "spec": {
        "pattern": "\\S",
        "title": "Spec",
        "type": "string"
      },
      "spec_gate": {
        "enum": [
          "ready",
          "needs_human"
        ],
        "title": "Spec Gate",
        "type": "string"
      },
      "slices": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/Slice"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "For a ready parent spec, return one entry per pull request. Use null otherwise.",
        "title": "Slices"
      }
    },
    "required": [
      "human_question",
      "spec",
      "spec_gate",
      "slices"
    ],
    "title": "SpecOutput",
    "type": "object"
  },
  "spec_check": {
    "$defs": {
      "FindingResolution": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "\\S",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "FindingResolution",
        "type": "object"
      },
      "SpecFinding": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "\\S",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "proof-obligation",
              "seam",
              "failure-path",
              "contract",
              "scope"
            ],
            "title": "Kind",
            "type": "string"
          },
          "slice": {
            "pattern": "\\S",
            "title": "Slice",
            "type": "string"
          },
          "section": {
            "enum": [
              "slice",
              "spec",
              "work_kind"
            ],
            "title": "Section",
            "type": "string"
          },
          "summary": {
            "maxLength": 200,
            "pattern": "\\S",
            "title": "Summary",
            "type": "string"
          },
          "ruling_id": {
            "anyOf": [
              {
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ruling Id"
          }
        },
        "required": [
          "id",
          "kind",
          "slice",
          "section",
          "summary",
          "ruling_id"
        ],
        "title": "SpecFinding",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "findings": {
        "description": "New blocking gaps only. Use resolutions for earlier IDs.",
        "items": {
          "$ref": "#/$defs/SpecFinding"
        },
        "title": "Findings",
        "type": "array"
      },
      "notes": {
        "description": "Nonblocking observations, separate from requested fixes.",
        "items": {
          "$ref": "#/$defs/SpecFinding"
        },
        "title": "Notes",
        "type": "array"
      },
      "resolutions": {
        "items": {
          "$ref": "#/$defs/FindingResolution"
        },
        "title": "Resolutions",
        "type": "array"
      }
    },
    "required": [
      "findings",
      "notes",
      "resolutions"
    ],
    "title": "SpecCheckOutput",
    "type": "object"
  },
  "implement": {
    "$defs": {
      "BrowserProof": {
        "additionalProperties": false,
        "description": "For a required screen, report only browser evidence you actually collected.",
        "properties": {
          "screen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screen"
          },
          "trace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          }
        },
        "required": [
          "screen",
          "trace",
          "passed"
        ],
        "title": "BrowserProof",
        "type": "object"
      },
      "ConstraintResult": {
        "additionalProperties": false,
        "properties": {
          "constraint": {
            "pattern": "\\S",
            "title": "Constraint",
            "type": "string"
          },
          "rejected": {
            "title": "Rejected",
            "type": "boolean"
          }
        },
        "required": [
          "constraint",
          "rejected"
        ],
        "title": "ConstraintResult",
        "type": "object"
      },
      "FormalProof": {
        "additionalProperties": false,
        "description": "For required properties, report only formal evidence you actually collected.",
        "properties": {
          "ran": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ran"
          },
          "constraints": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/ConstraintResult"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraints"
          },
          "typecheck": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typecheck"
          }
        },
        "required": [
          "ran",
          "constraints",
          "typecheck"
        ],
        "title": "FormalProof",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "implementation": {
        "pattern": "\\S",
        "title": "Implementation",
        "type": "string"
      },
      "browser_proof": {
        "anyOf": [
          {
            "$ref": "#/$defs/BrowserProof"
          },
          {
            "type": "null"
          }
        ]
      },
      "formal_proof": {
        "anyOf": [
          {
            "$ref": "#/$defs/FormalProof"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "implementation",
      "browser_proof",
      "formal_proof"
    ],
    "title": "ImplementOutput",
    "type": "object"
  },
  "review": {
    "$defs": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "side": {
            "enum": [
              "head",
              "base"
            ],
            "title": "Side",
            "type": "string"
          },
          "path": {
            "pattern": "\\S",
            "title": "Path",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          }
        },
        "required": [
          "side",
          "path",
          "line"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Dimension": {
        "additionalProperties": false,
        "properties": {
          "applies": {
            "title": "Applies",
            "type": "boolean"
          },
          "assessment": {
            "pattern": "\\S",
            "title": "Assessment",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "applies",
          "assessment",
          "evidence"
        ],
        "title": "Dimension",
        "type": "object"
      },
      "FindingResolution": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "\\S",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "FindingResolution",
        "type": "object"
      },
      "GraphCheck": {
        "additionalProperties": false,
        "properties": {
          "head": {
            "pattern": "\\S",
            "title": "Head",
            "type": "string"
          },
          "command": {
            "pattern": "\\S",
            "title": "Command",
            "type": "string"
          },
          "exit_code": {
            "title": "Exit Code",
            "type": "integer"
          }
        },
        "required": [
          "head",
          "command",
          "exit_code"
        ],
        "title": "GraphCheck",
        "type": "object"
      },
      "MergeRisk": {
        "additionalProperties": false,
        "properties": {
          "alignment": {
            "$ref": "#/$defs/Dimension"
          },
          "impact": {
            "$ref": "#/$defs/Dimension"
          },
          "verification": {
            "$ref": "#/$defs/Dimension"
          },
          "rollback": {
            "$ref": "#/$defs/Dimension"
          },
          "error_detection": {
            "$ref": "#/$defs/Dimension"
          },
          "level": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level",
            "type": "string"
          }
        },
        "required": [
          "alignment",
          "impact",
          "verification",
          "rollback",
          "error_detection",
          "level"
        ],
        "title": "MergeRisk",
        "type": "object"
      },
      "ReviewFinding": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Unique finding ID. Never reuse an earlier finding ID.",
            "pattern": "\\S",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "correctness",
              "contract-unenforced",
              "duplicate-owner",
              "hand-built-parsing",
              "untested-path",
              "docs"
            ],
            "title": "Kind",
            "type": "string"
          },
          "fix": {
            "description": "State the requested fix.",
            "pattern": "\\S",
            "title": "Fix",
            "type": "string"
          },
          "ruling_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If this contradicts a settled ruling, give its ID so it becomes a coordinator note. Otherwise null.",
            "title": "Ruling Id"
          },
          "file": {
            "description": "Give the path relative to the repository root.",
            "pattern": "\\S",
            "title": "File",
            "type": "string"
          },
          "line": {
            "description": "Give the line number in the reviewed commit.",
            "exclusiveMinimum": 0,
            "title": "Line",
            "type": "integer"
          },
          "severity": {
            "enum": [
              "blocking",
              "nit"
            ],
            "title": "Severity",
            "type": "string"
          },
          "summary": {
            "maxLength": 200,
            "pattern": "\\S",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "fix",
          "ruling_id",
          "file",
          "line",
          "severity",
          "summary"
        ],
        "title": "ReviewFinding",
        "type": "object"
      },
      "ToolFact": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "description": "State the outside-tool behavior the diff relies on.",
            "pattern": "\\S",
            "title": "Claim",
            "type": "string"
          },
          "graph_check": {
            "anyOf": [
              {
                "$ref": "#/$defs/GraphCheck"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only for an exact graph check restatement. Copy its claim verbatim and its structured evidence; otherwise null."
          },
          "fixture": {
            "anyOf": [
              {
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Give the exact entry ID in the run state fact_record. Use null when the claim has no recorded evidence.",
            "title": "Fixture"
          }
        },
        "required": [
          "claim",
          "graph_check",
          "fixture"
        ],
        "title": "ToolFact",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "resolutions": {
        "description": "Mark every earlier unresolved reviewer finding once. The graph resolves tool-fact gate findings. Return an empty list in round 1.",
        "items": {
          "$ref": "#/$defs/FindingResolution"
        },
        "title": "Resolutions",
        "type": "array"
      },
      "risk": {
        "$ref": "#/$defs/MergeRisk"
      },
      "findings": {
        "description": "List each new requested fix, including nits. Return an empty list when there are none.",
        "items": {
          "$ref": "#/$defs/ReviewFinding"
        },
        "title": "Findings",
        "type": "array"
      },
      "tool_facts": {
        "description": "List every outside-tool fact the diff relies on, including unrecorded facts. Use an empty list if there are none.",
        "items": {
          "$ref": "#/$defs/ToolFact"
        },
        "title": "Tool Facts",
        "type": "array"
      }
    },
    "required": [
      "resolutions",
      "risk",
      "findings",
      "tool_facts"
    ],
    "title": "ReviewOutput",
    "type": "object"
  },
  "verify": {
    "additionalProperties": false,
    "properties": {
      "verify": {
        "enum": [
          "pass",
          "fail"
        ],
        "title": "Verify",
        "type": "string"
      }
    },
    "required": [
      "verify"
    ],
    "title": "VerifyOutput",
    "type": "object"
  }
}
