flowchart TD
  start(["New issue"]):::big --> load["Before the graph, the runner loads the issue"]
  load -.-> f1[/"gh issue view ISSUE --json title,body,labels"/]:::file
  load --> kind{"Labelled slice?"}
  kind -->|yes| json{"Body has a valid fenced JSON slice?"}
  json -->|no| h1["HALT missing_slice, terminal<br/>the slice issue has no readable slice"]:::halt
  json -->|yes| blk{"Any open or unmerged blockers?"}
  blk -.-> f2[/"gh api repos/R/issues/ISSUE/dependencies/blocked_by<br/>gh issue view and gh pr view per blocker"/]:::file
  blk -->|yes| stop(["Stops before the graph: blocked"]):::big
  blk -->|no| brief
  kind -->|no| brief["Build the instructions"]
  brief -.-> f3[/"stages/triage.md"/]:::file
  brief -.-> f4[/"skill, always: poteto-mode/SKILL.md, line 110 only"/]:::file
  brief --> cell{{"Dispatch cell<br/>1 claude-opus-5-5-high<br/>2 grok-4.7-high<br/>3 gpt-6.1-sol-high<br/>all eligible, read-only"}}:::model
  cell --> out["Output checked against TriageOutput<br/>work_kind, triage, slice, human_question<br/>a slice issue keeps its own work_kind"]
  out --> d{"What did triage decide?"}
  d -->|needs_human| ask["ASK Joe the human_question<br/>the answer is saved and triage runs again with it"]:::pause
  ask --> brief
  d -->|question| x1(["question<br/>to research"]):::big
  d -->|spec| x2(["needs a plan<br/>to spec"]):::big
  d -->|implement| one{"Slice issue, or a parent that returned exactly one slice?"}
  one -->|no| h2["HALT invalid_output, terminal<br/>a parent triaged as implement needs its slice"]:::halt
  one -->|yes| cand["Save the one-slice plan candidate<br/>author family is the triage model's"]
  cand --> x3(["one slice<br/>to spec_check"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
