flowchart TD
  e1(["from review"]):::big --> body["Write the review, event COMMENT<br/>verdict line and detail; inline comments on added lines;<br/>other findings listed in the body"]
  body --> same{"PR unchanged since the review?<br/>open, same base, same head"}
  same -.-> f1[/"gh pr view N --repo R"/]:::file
  same -->|no| h1["HALT review_not_posted, retry"]:::halt
  same -->|yes| dup{"This round's review already posted?<br/>matched by its hidden marker"}
  dup -.-> f2[/"gh api repos/R/pulls/N/reviews --paginate"/]:::file
  dup -->|no| post["Post it"]
  post -.-> f3[/"gh api repos/R/pulls/N/reviews --method POST"/]:::file
  post -->|GitHub error| h1
  post --> rec
  dup -->|yes| rec["Save the receipt: review ID and commit"]
  rec --> rt{"The same kind of finding keeps coming back?"}
  rt -->|yes| ask["ASK Joe for the design direction<br/>the answer becomes a settled ruling"]:::pause
  ask --> cap
  rt -->|no| v{"Verdict"}
  v -->|approve| x1(["approve<br/>to merge"]):::big
  v -->|changes| cap{"Fewer than 3 review rounds so far?"}
  cap -->|yes| x2(["changes: resume same PR branch<br/>to prepare"]):::big
  cap -->|no| h2["HALT review_cap, terminal<br/>review still wants changes after 3 rounds"]:::halt
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
