flowchart TD
  e1(["from proof: pass"]):::big --> st{"Clean, on the PR branch, at the commit just made?"}
  st -.-> f1[/"git status --porcelain<br/>git branch --show-current<br/>git rev-parse HEAD"/]:::file
  st -->|no| h1["HALT publish_failed, retry"]:::halt
  st -->|yes| org{"origin points at this GitHub repo?"}
  org -.-> f2[/"git remote get-url origin<br/>git remote get-url --push --all origin"/]:::file
  org -->|no| h1
  org -->|yes| up{"Remote branch already at this commit?"}
  up -.-> f3[/"git ls-remote origin refs/heads/BRANCH"/]:::file
  up -->|no| push["Push the branch"]
  push -.-> f4[/"git push --no-follow-tags origin refs/heads/BRANCH:refs/heads/BRANCH"/]:::file
  push --> pr
  up -->|yes| pr{"An open PR for this branch?"}
  pr -.-> f5[/"gh pr view BRANCH --repo R"/]:::file
  pr -->|closed, or on another base| h1
  pr -->|none| open["Open the PR<br/>title is the slice title, body is Closes #35;ISSUE"]
  open -.-> f6[/"gh pr create --repo R --base BASE --head BRANCH"/]:::file
  open --> x1(["to review"]):::big
  pr -->|yes| x1
  push -->|Git error| h1
  open -->|GitHub error| h1
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
