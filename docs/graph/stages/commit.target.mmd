flowchart TD
  e1(["from size: fits"]):::big --> who{"Implement model recorded?"}
  who -->|no| h1["HALT, terminal<br/>the commit needs the implement model's name"]:::halt
  who -->|yes| msg["Write the message<br/>ISSUE: slice title, 72 characters at most<br/>Co-Authored-By the implement model's family"]
  msg --> on{"Still on the PR branch?"}
  on -.-> f1[/"git branch --show-current<br/>git status --porcelain"/]:::file
  on -->|no| h2["HALT git_failed, retry"]:::halt
  on -->|yes| kind{"Candidate is worker commits?"}
  kind -->|yes| soft["Fold them back into edits on the attempt start"]
  soft -.-> f2[/"git reset --soft START"/]:::file
  soft --> fp
  kind -->|no| fp{"Change still matches the saved fingerprint?"}
  fp -.-> f3[/"git diff HEAD --binary<br/>git ls-files --others --exclude-standard"/]:::file
  fp -->|no| h2
  fp -->|yes| again{"An earlier try already made this commit?<br/>same parent and same message"}
  again -.-> f4[/"git show -s --format=%P%n%B HEAD"/]:::file
  again -->|yes| rec
  again -->|no| mk["Commit"]
  mk -.-> f5[/"git add --all<br/>git commit -m MESSAGE"/]:::file
  mk --> cl{"Checkout clean after the commit?"}
  cl -->|no| h2
  cl -->|yes| rec["Record the commit SHA"]
  rec --> x1(["to verify"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
