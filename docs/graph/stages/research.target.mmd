flowchart TD
  e1(["from triage: question"]):::big --> brief["Build the instructions"]
  brief -.-> f1[/"stages/research.md"/]:::file
  brief -.-> f2[/"skill, always: how/SKILL.md, line 17 only"/]:::file
  brief -.-> f3[/"skill, when work_kind is bug_fix: why/SKILL.md"/]:::file
  brief --> cell{{"Dispatch cell<br/>1 claude-opus-5-5-high<br/>2 grok-4.7-high<br/>3 gpt-6.1-sol-high<br/>all eligible, read-only, no code changes"}}:::model
  cell -.-> f4[/"reads the repository checkout"/]:::file
  cell --> out["Output checked against ResearchOutput<br/>research: the answer text"]
  out --> save["Save the answer in the run result"]
  save --> dup{"Answer already posted on the issue?<br/>matched by its hidden marker"}
  dup -.-> f5[/"gh api repos/R/issues/ISSUE/comments --paginate"/]:::file
  dup -->|no| post["Post the answer as an issue comment"]
  post -.-> f6[/"gh api repos/R/issues/ISSUE/comments --method POST"/]:::file
  post -->|GitHub error| h1["HALT, retry<br/>the answer was not posted; a rerun resumes here"]:::halt
  post --> x1(["to done"]):::big
  dup -->|yes| x1
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
