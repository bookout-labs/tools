flowchart TD
  e1(["from spec_check: approved slice"]):::big --> clean
  e2(["from verify, proof, review_post or merge:<br/>resume same PR branch"]):::big --> clean
  clean{"Checkout clean?"}
  clean -.-> f1[/"git status --porcelain"/]:::file
  clean -->|no| h1["HALT dirty_worktree, terminal<br/>edits Foreman does not own; save them, then rerun"]:::halt
  clean -->|yes| env{"Preflight command passes?"}
  env -.-> f2[/"the --preflight command, run in the checkout"/]:::file
  env -->|no| h2["HALT env_unavailable, retry<br/>the environment is broken, not the code"]:::halt
  env -->|yes| name["Branch is ISSUE-slice-title<br/>base is the repo's default branch"]
  name -.-> f3[/"gh repo view R --json defaultBranchRef<br/>first attempt only"/]:::file
  name --> has{"PR branch already exists?"}
  has -.-> f4[/"git for-each-ref refs/heads/BRANCH"/]:::file
  has -->|yes| sw["Switch to it, after checking it contains the base"]
  sw -.-> f5[/"git merge-base --is-ancestor BASE BRANCH<br/>git switch BRANCH"/]:::file
  has -->|no| mk["Create it from the base"]
  mk -.-> f6[/"git switch -c BRANCH refs/heads/BASE"/]:::file
  sw --> newer{"Sent back by merge with a newer PR head?"}
  mk --> newer
  newer -->|yes| ff["Fetch the PR head and fast-forward to it"]
  ff -.-> f7[/"git fetch --no-tags origin refs/heads/BRANCH<br/>git merge --ff-only FETCH_HEAD"/]:::file
  ff --> same{"Fetched head is the one merge saw?"}
  same -->|no| h3["HALT git_failed, retry<br/>the PR head moved again"]:::halt
  same -->|yes| rec
  newer -->|no| rec["Record the attempt start<br/>make a fresh worker scratch folder outside the checkout"]
  rec -.-> f8[/"git rev-parse HEAD"/]:::file
  rec --> x1(["to implement"]):::big
  sw -->|Git error| h3
  mk -->|Git error| h3
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
