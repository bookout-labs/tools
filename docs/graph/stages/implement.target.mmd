flowchart TD
  e1(["from prepare"]):::big --> brief["Build the instructions"]
  brief -.-> f1[/"stages/implement.md"/]:::file
  brief -.-> f2[/"skills, always: principle-laziness-protocol,<br/>principle-test-behavior-not-implementation, principle-prove-it-works"/]:::file
  brief -.-> f3[/"skills, by condition:<br/>bug_fix: tdd/SKILL.md<br/>perf_issue: benchmark-checklist/SKILL.md<br/>slice names a screen: Foreman skills/browser-proof.md<br/>slice names database properties: Foreman skills/formal-proof.md"/]:::file
  brief -.-> f4[/"added text: the fact record path tests/fixtures/manifest.toml,<br/>open review findings to fix, nits included,<br/>and, after unrecorded tool facts, how to record evidence plus the facts"/]:::file
  brief --> cell{{"Dispatch cell<br/>1 gpt-6.1-sol-high<br/>2 gpt-6.1-terra-high<br/>3 claude-opus-5-5-high<br/>4 grok-4.7-high<br/>all eligible; may edit files, must not commit or publish"}}:::model
  cell -.-> f5[/"worker writes files in the checkout<br/>and in its scratch folder"/]:::file
  cell -->|resumed after a quota wait| pe{"Partial edits unchanged since the pause?"}
  pe -.-> f6[/"git diff HEAD --binary<br/>git ls-files --others --exclude-standard"/]:::file
  pe -->|no| h1["HALT dirty_worktree, terminal<br/>someone changed the edits during the pause"]:::halt
  pe -->|yes, the next model continues the edits| cell
  cell --> out["Output checked against ImplementOutput<br/>implementation summary, browser_proof, formal_proof"]
  out --> x1(["to reconcile"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
