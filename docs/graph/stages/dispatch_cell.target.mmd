flowchart TD
  e1(["from a model step<br/>its instructions, output contract and model list"]):::big --> crash{"A saved call from before a crash, with no result?"}
  crash -.-> f1[/"checkpoint database: the pending call"/]:::file
  crash -->|yes| h1["HALT usage_unknown, terminal<br/>a model may have run and billed; usage is unknown"]:::halt
  crash -->|no| budget{"Run still inside its token and dollar allowance?"}
  budget -->|no| h2["HALT budget_exceeded, terminal"]:::halt
  budget -->|yes| elig{"Any eligible model in the list?<br/>review and spec_check drop no family:<br/>other families first, then the author's family,<br/>the author's own model last<br/>the author is the plan's writer, or for review the PR's builders"}
  elig -->|no| h3["HALT, terminal<br/>the config leaves no eligible model"]:::halt
  elig -->|yes| next{"An eligible model not yet tried?"}
  next -->|yes| save["plan: save the pending call<br/>step, model, instructions, skills"]
  save -.-> f1
  save --> run{{"call: run one model, as a durable task<br/>claude -p, codex exec or grok -p, with the output schema<br/>only implement may edit; a paid call is never repeated"}}:::model
  run -.-> f2[/"the worker CLI, run in the checkout<br/>gets the instructions, the schema and the delivery state"/]:::file
  run --> rec["Record the attempt once<br/>model, tokens, dollars, skills, pstack commit"]
  rec --> what{"What came back?"}
  what -->|quota used up, or CLI missing| next
  what -->|ran without a usage report| h1
  what -->|dollar limit hit, or tokens over the cap| h2
  what -->|worker failed| h4["HALT invalid_output, terminal"]:::halt
  what -->|a result| fit{"Result matches the step's output contract?"}
  fit -->|no| h4
  fit -->|yes| x1(["result<br/>back to the step"]):::big
  next -->|no| wait["PAUSE wait<br/>until a model is available: quota returns or a CLI is installed<br/>resumes at plan with the list starting over"]:::pause
  wait --> next
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
