flowchart TD
  e1(["from review_post: approve"]):::big --> st{"Checkout clean, on the branch,<br/>at the verified head?"}
  st -.-> f1[/"git status --porcelain<br/>git rev-parse HEAD"/]:::file
  st -->|head differs| x2(["head moved: resume same PR branch<br/>to prepare"]):::big
  st -->|dirty or detached| h1["HALT merge_not_armed, retry"]:::halt
  st -->|yes| hold{"FOREMAN_MERGE_HOLD repo variable set, or unreadable?"}
  hold -.-> f2[/"gh variable list --repo R --json name,value"/]:::file
  hold -->|yes| h2["HALT merge_held, retry<br/>resumes once the hold is cleared"]:::halt
  hold -->|no| rcpt{"Posted review is at this head,<br/>nothing unresolved, tool facts recorded?"}
  rcpt -->|no| h1
  rcpt -->|yes| saved{"Already handed to the merge queue for this head?"}
  saved -->|yes| q
  saved -->|no| obs["Observe readiness<br/>the PR, branch rules, checks and statuses"]
  obs -.-> f3[/"gh api repos/R/pulls/N<br/>gh api repos/R/rules/branches/BASE<br/>gh api repos/R/branches/BASE<br/>gh api repos/R/commits/SHA/check-runs and /statuses"/]:::file
  obs --> rd{"Readiness"}
  rd -->|merge conflict| h3["HALT pr_conflict, retry"]:::halt
  rd -->|checks still running| p1["PAUSE ci_pending<br/>waiting on GitHub; resumes here"]:::pause
  rd -->|checks red| h4["HALT ci_red, retry"]:::halt
  rd -->|rules unreadable| h5["HALT readiness_unavailable, retry"]:::halt
  rd -->|PR closed or retargeted| h1
  rd -->|PR head changed| x2
  rd -->|ready| arm["Arm auto-merge for this exact head<br/>unless the queue already has it"]
  arm -.-> f4[/"gh pr merge N --repo R --auto --match-head-commit SHA"/]:::file
  arm --> q{"Merge queue state for this head"}
  q -.-> f5[/"gh api graphql: mergeQueueEntry, autoMergeRequest"/]:::file
  q -->|merged| deps["Mark ready each issue this one blocks<br/>whose blockers have all merged"]
  deps -.-> f6[/"gh api repos/R/issues/ISSUE/dependencies/blocking<br/>gh api repos/R/issues/DEP/dependencies/blocked_by<br/>gh issue edit DEP --add-label factory"/]:::file
  deps -->|GitHub error| h6["HALT, retry<br/>a dependent was not marked ready; a rerun resumes here"]:::halt
  deps --> x1(["merged<br/>to done"]):::big
  q -->|queued or testing| p2["PAUSE waiting on GitHub<br/>the queue is still testing<br/>the PR-merged webhook resumes the run here"]:::pause
  q -->|rejected, or the entry is gone| x3(["queue rejected: fix on same PR branch<br/>to prepare"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
