flowchart TD
  e1(["from spec: the plan"]):::big --> carry
  e2(["from triage: one slice"]):::big --> carry
  carry{"Already approved at this exact revision?<br/>a child slice unchanged since its parent plan was approved"}
  carry -.-> f4[/"the slice's provenance revision in the issue body"/]:::file
  carry -->|yes, no model call| par
  carry -->|no| brief
  brief["Build the instructions<br/>the exact candidate, open findings,<br/>changed sections, settled rulings"]
  brief -.-> f1[/"stages/spec_check.md"/]:::file
  brief -.-> f2[/"skills, always: principle-model-the-domain, principle-boundary-discipline,<br/>principle-type-system-discipline, principle-prove-it-works"/]:::file
  brief -.-> f5[/"skill, always: interrogate/SKILL.md<br/>its method only, followed by this one model"/]:::file
  brief --> cell{{"Dispatch cell<br/>1 claude-opus-5-5-high<br/>2 gpt-6.1-sol-high<br/>try order: models outside the plan author's family first,<br/>then the author's family, the author's own model last<br/>Neon joins this list after #35;146<br/>one model, read-only, no subagents"}}:::model
  cell --> out["Output checked against SpecCheckOutput<br/>findings, notes, resolutions"]
  out --> acc{"Accepted against the exact candidate?<br/>IDs unique across rounds, each finding names a candidate slice,<br/>every earlier open ID resolved exactly once"}
  acc -.-> f3[/"spec_check.py accept"/]:::file
  acc -->|no| h1["HALT invalid_output, terminal"]:::halt
  acc -->|yes| open{"Any blocking finding still open?<br/>findings that cite a settled ruling become notes"}
  open -->|no| appr["Approval bound to this exact revision"]
  appr --> par{"Plan has more than one slice?"}
  par -->|yes| x1(["parent plan<br/>to file_slices"]):::big
  par -->|no| x2(["approved slice<br/>to prepare"]):::big
  open -->|yes| stuck{"Same kind of gap recurring,<br/>or the round cap reached?"}
  stuck -->|no| x3(["gaps: repair the plan<br/>to spec"]):::big
  stuck -->|yes| ask["ASK Joe about the open gaps<br/>the answer becomes a settled ruling"]:::pause
  ask --> x3
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
