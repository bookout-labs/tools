flowchart TD
  e1(["from triage: needs a plan"]):::big --> brief
  e2(["from spec_check: gaps, repair the plan"]):::big --> brief
  e3(["from size: too big, re-plan"]):::big --> brief
  brief["Build the instructions"]
  brief -.-> f1[/"stages/spec.md"/]:::file
  brief -.-> f2[/"skills, always: principle-redesign-from-first-principles,<br/>principle-subtract-before-you-add, principle-model-the-domain,<br/>principle-boundary-discipline, principle-type-system-discipline"/]:::file
  brief -.-> f3[/"skill, when the slice is marked stateful: statechart/SKILL.md"/]:::file
  brief -.-> f4[/"added text: spec_check's open findings and settled rulings on a repair,<br/>the measured line count and the 400 limit on a re-plan,<br/>the last slice-plan rejection, Joe's answers"/]:::file
  brief --> cell{{"Dispatch cell<br/>1 claude-opus-5-5-high<br/>2 grok-4.7-high<br/>3 gpt-6.1-sol-high<br/>all eligible, read-only"}}:::model
  cell --> out["Output checked against SpecOutput<br/>spec, spec_gate, slices, human_question"]
  out --> gate{"spec_gate"}
  gate -->|needs_human| ask["ASK Joe the human_question<br/>the answer is saved and spec runs again with it"]:::pause
  ask --> brief
  gate -->|ready| order["Order the slices<br/>unique titles, one builder per seam,<br/>each used seam has a builder or an existing file, no cycles"]
  order -.-> f5[/"checks each named seam file exists in the checkout"/]:::file
  order --> ok{"Slice plan valid?"}
  ok -->|no| tries{"Fewer than 3 rejections so far?"}
  tries -->|yes, run spec again with the rejection| brief
  tries -->|no| h1["HALT spec_cap, terminal<br/>the slice plan kept failing its checks"]:::halt
  ok -->|yes| re{"Is this a re-plan from size?"}
  re -->|yes| shrink{"Every slice has a new seam<br/>and is strictly smaller than the measured PR?"}
  shrink -->|no| ask2["ASK Joe<br/>no re-plan makes strictly smaller slices<br/>split anyway, or override for this PR?"]:::pause
  ask2 -->|split: your guidance goes into the next spec| brief
  ask2 -->|override| ov["Record the override for this PR<br/>the saved candidate is kept as it is"]
  ov --> x2(["override: keep this PR<br/>to size, NEW ARROW needing approval"]):::big
  shrink -->|yes| cand
  re -->|no| cand["Save the one plan candidate<br/>its revision hash and author family"]
  cand --> x1(["to spec_check"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef pause fill:#fff4cc,stroke:#a15c00,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef model fill:#e6f4ea,stroke:#1e7a34,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
