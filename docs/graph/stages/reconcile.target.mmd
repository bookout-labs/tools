flowchart TD
  e1(["from implement"]):::big --> look["Look at the checkout"]
  look -.-> f1[/"git rev-parse HEAD<br/>git status --porcelain<br/>git branch --show-current"/]:::file
  look --> br{"Still on the PR branch?"}
  br -->|no| h2
  br -->|yes| moved{"Did the worker make commits?"}
  moved -->|no| any{"Any edits at all?"}
  any -.-> f2[/"git diff HEAD --binary<br/>git ls-files --others --exclude-standard"/]:::file
  any -->|no| h1["HALT failed, terminal<br/>no changes; lists the findings still open"]:::halt
  any -->|yes| scr
  moved -->|yes| chain{"Commits clean, one line of non-empty commits<br/>on the attempt start, branch not yet pushed past it?"}
  chain -.-> f3[/"git merge-base --is-ancestor START HEAD<br/>git show -s --format=%P<br/>git ls-remote origin refs/heads/BRANCH"/]:::file
  chain -->|no| h2["HALT implementation_rejected, retry<br/>names what is wrong; after you fix the tree,<br/>a rerun resumes here and implement does not run again"]:::halt
  chain -->|yes| scr{"Whole change since the attempt start is free of scratch?<br/>no path the base's .gitignore ignores;<br/>fact records and their captures are allowed"}
  scr -.-> f4[/"git check-ignore, using .gitignore at the merge base"/]:::file
  scr -->|no| h2
  scr -->|yes| cand["Save the candidate<br/>worker commits or edits, plus a fingerprint of the exact change"]
  cand --> x1(["to size"]):::big
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
