flowchart TD
  e1(["from spec_check: parent plan"]):::big --> each["Take the next slice, in dependency order"]
  each --> found{"A child issue with this slice's marker already exists?"}
  found -.-> f1[/"gh api repos/R/issues?state=all --paginate"/]:::file
  found -->|no| make["Create the child issue<br/>slice JSON in the body, label slice"]
  make -.-> f2[/"gh api repos/R/issues --method POST"/]:::file
  make --> link
  found -->|yes| link["Link it as a sub-issue of this issue"]
  link -.-> f3[/"gh api repos/R/issues/ISSUE/sub_issues --method POST"/]:::file
  link --> conf{"GitHub confirms the sub-issue link?"}
  conf -.-> f4[/"gh api repos/R/issues/ISSUE/sub_issues"/]:::file
  conf -->|no| h1["HALT, retry<br/>GitHub did not confirm a write<br/>a rerun resumes here and finds children by marker"]:::halt
  conf -->|yes| deps["Add a blocked-by link for each slice it depends on"]
  deps -.-> f5[/"gh api repos/R/issues/CHILD/dependencies/blocked_by --method POST"/]:::file
  deps --> free{"Depends on nothing?"}
  free -->|yes| ready["Mark it ready for the factory"]
  ready -.-> f6[/"gh issue edit CHILD --add-label factory"/]:::file
  ready --> more
  free -->|no| more{"More slices?"}
  more -->|yes| each
  more -->|no| x1(["to done"]):::big
  make -->|GitHub error| h1
  deps -->|GitHub error| h1
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
