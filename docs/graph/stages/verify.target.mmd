flowchart TD
  e1(["from commit"]):::big --> cl{"Checkout clean?"}
  cl -.-> f1[/"git status --porcelain"/]:::file
  cl -->|no| h1["HALT dirty_worktree, terminal"]:::halt
  cl -->|yes| run["Run the repo's check command in the checkout<br/>and stream its log"]
  run -.-> f2[/"the --check command, chosen per run<br/>for example python -m unittest discover -s tests"/]:::file
  run --> code{"Exit code"}
  code -->|126 or 127, the command cannot start| h2["HALT env_unavailable, retry"]:::halt
  code -->|0| pass["Record the verified head"]
  pass --> x1(["pass<br/>to proof"]):::big
  code -->|any other| pre{"Preflight still passes?"}
  pre -.-> f3[/"the --preflight command"/]:::file
  pre -->|no| h2
  pre -->|yes| fails{"Fewer than 3 failed checks so far?"}
  fails -->|yes| x2(["fail: resume same PR branch<br/>to prepare"]):::big
  fails -->|no| h3["HALT verify_cap, terminal<br/>the check failed 3 times"]:::halt
  classDef halt fill:#fde2e2,stroke:#b42318,color:#111
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
