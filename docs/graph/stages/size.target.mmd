flowchart TD
  e1(["from reconcile"]):::big --> base["Find the merge base with the PR's base branch"]
  base -.-> f1[/"git fetch --no-tags origin +refs/heads/BASE:refs/remotes/origin/BASE<br/>git merge-base origin/BASE CANDIDATE"/]:::file
  base --> count["Count every changed line of the candidate<br/>skip only files the base's .gitattributes marks linguist-generated<br/>binaries and renames are counted from the patch"]
  count -.-> f2[/"git diff --numstat -z --find-renames<br/>git check-attr linguist-generated, attributes from the merge base<br/>git diff --patch --unified=0, for binaries"/]:::file
  count --> fixr{"A fix round of a PR that already passed size?"}
  fixr -->|yes| x1(["fits<br/>to commit"]):::big
  fixr -->|no| lim{"400 changed lines or fewer?"}
  lim -->|yes| x1
  lim -->|no| ov{"Joe overrode the size for this PR?"}
  ov -->|yes| x1
  ov -->|no| x2(["too big: re-plan<br/>to spec, with the count"]):::big
  classDef file fill:#eef2ff,stroke:#4f5bd5,color:#111
  classDef big fill:#f2f2f2,stroke:#555,color:#111
