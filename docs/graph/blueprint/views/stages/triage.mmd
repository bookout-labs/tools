flowchart TD
    n0(["Ready label added to an issue"]):::terminal
    n1["Foreman · Check repository readiness on GitHub, read the issue for a stop, then pin the base, check the contract, and validate the issue and prerequisites"]:::step
    n2(["Triage worker · Classify the admitted issue"]):::worker
    n3(["Run stops<br/>Reported on the issue"]):::terminal
    n4(["Cancelled<br/>Reported on the issue"]):::terminal
    n5["Continue to Research stage"]:::stage
    n6["Continue to Spec stage"]:::stage
    n7{{"Human<br/>• Clarify issue intent<br/>• Answer or cancel<br/>• Resume triage"}}:::gate
    n0 -->|"Ready label, dependent recheck or revert issue"| n1
    n1 -->|"Admitted"| n2
    n1 -->|"Not ready"| n3
    n1 --> n4
    n2 -->|"Question"| n5
    n2 -->|"Plan / Supplied slice"| n6
    n2 --> n4
    n2 --> n3
    n2 -.->|"Unresolved choice"| n7
    n7 -.-> n2
    classDef stage fill:#dcebf8,stroke:#315675,color:#10283b
    classDef step fill:#edf3f8,stroke:#597187,color:#132638
    classDef worker fill:#d7f0e8,stroke:#357369,color:#133c36
    classDef gate fill:#fff0c9,stroke:#89641f,color:#3f2b0b
    classDef terminal fill:#f0f0f0,stroke:#666666,color:#202020
