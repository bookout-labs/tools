flowchart TD
    n0(["Enter stage"]):::terminal
    n1["Foreman · Read the issue for a stop, then prepare the attempt container, reconcile the worktree and run the check at the base. On a conflict repair, also check the base head and merge the base head into the owned branch"]:::step
    n2(["Acceptance test writer · Write acceptance tests from the plan and the base tree"]):::worker
    n3(["Builder · Edit and run the check with the accepted tests"]):::worker
    n4["Foreman · Mutate a capped sample of changed lines outside test files"]:::step
    n5["Foreman · Commit or adopt the checked tree"]:::step
    n6["Foreman · Publish the checked commit"]:::step
    n7(["Cancelled<br/>Reported on the issue"]):::terminal
    n8(["Run stops<br/>Reported on the issue"]):::terminal
    n9(["No change<br/>Reported on the issue"]):::terminal
    n10["Continue to Verify stage"]:::stage
    n11{{"Human<br/>• Resolve acceptance choice<br/>• Choose or cancel<br/>• Resume editing"}}:::gate
    n0 --> n1
    n1 --> n7
    n1 --> n8
    n1 -->|"Needs tests"| n2
    n1 -->|"Prepared"| n3
    n2 --> n8
    n2 -->|"Tests rejected"| n2
    n2 -->|"Tests accepted"| n3
    n3 --> n7
    n3 --> n9
    n3 --> n8
    n3 -->|"Check failed / Checks weakened"| n3
    n3 -->|"Checked"| n4
    n4 --> n8
    n4 -->|"Mutation survived"| n3
    n4 -->|"Mutations caught"| n5
    n5 --> n8
    n5 -->|"Committed"| n6
    n6 --> n8
    n6 -->|"Owned head moved"| n1
    n6 -->|"Published"| n10
    n3 -.->|"Unresolved choice"| n11
    n11 -.-> n3
    classDef stage fill:#dcebf8,stroke:#315675,color:#10283b
    classDef step fill:#edf3f8,stroke:#597187,color:#132638
    classDef worker fill:#d7f0e8,stroke:#357369,color:#133c36
    classDef gate fill:#fff0c9,stroke:#89641f,color:#3f2b0b
    classDef terminal fill:#f0f0f0,stroke:#666666,color:#202020
