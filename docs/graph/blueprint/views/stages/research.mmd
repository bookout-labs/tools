flowchart TD
    n0(["Enter stage"]):::terminal
    n1(["Research worker · Return a sourced answer"]):::worker
    n2["Foreman · Post the saved answer"]:::step
    n3(["Cancelled"]):::terminal
    n4(["Run stops"]):::terminal
    n5(["Answered"]):::terminal
    n6{{"Joe · Provide the missing external source or clarify the question. Only an answer to the open question continues the run. Silence keeps the gate open. An unrelated reply does not count. Gates are only for unresolved questions. Plan approval never waits on Joe."}}:::gate
    n0 --> n1
    n1 -->|"Answer"| n2
    n1 --> n3
    n1 --> n4
    n2 --> n5
    n2 --> n4
    n1 -.->|"Unresolved choice"| n6
    n6 -.->|"Answer to open question"| n1
    classDef stage fill:#dcebf8,stroke:#315675,color:#10283b
    classDef step fill:#edf3f8,stroke:#597187,color:#132638
    classDef worker fill:#d7f0e8,stroke:#357369,color:#133c36
    classDef gate fill:#fff0c9,stroke:#89641f,color:#3f2b0b
    classDef terminal fill:#f0f0f0,stroke:#666666,color:#202020
