flowchart TD
    n0(["Enter stage"]):::terminal
    n1(["Reviewer · Run three fresh passes with another family preferred"]):::worker
    n2["Foreman · Run each blocking demonstration at the reviewed head"]:::step
    n3["Foreman · Post exact-head findings"]:::step
    n4["Foreman · Route by finding severity"]:::step
    n5["Continue to Implement stage"]:::stage
    n6(["Cancelled<br/>Reported on the issue"]):::terminal
    n7(["Run stops<br/>Reported on the issue"]):::terminal
    n8["Continue to Merge stage"]:::stage
    n9{{"Human<br/>• Resolve scope or rule<br/>• Decide or cancel<br/>• Resume review"}}:::gate
    n0 --> n1
    n1 -->|"PR revision changed"| n5
    n1 --> n6
    n1 --> n7
    n1 -->|"Assessed"| n2
    n2 -->|"PR revision changed"| n5
    n2 --> n7
    n2 -->|"Demonstrated"| n3
    n3 -->|"PR revision changed"| n5
    n3 --> n7
    n3 -->|"Posted"| n4
    n4 --> n7
    n4 -->|"Critical defect / Serious defect"| n5
    n4 -->|"No blocking finding"| n8
    n1 -.->|"Unresolved choice"| n9
    n9 -.-> n1
    classDef stage fill:#dcebf8,stroke:#315675,color:#10283b
    classDef step fill:#edf3f8,stroke:#597187,color:#132638
    classDef worker fill:#d7f0e8,stroke:#357369,color:#133c36
    classDef gate fill:#fff0c9,stroke:#89641f,color:#3f2b0b
    classDef terminal fill:#f0f0f0,stroke:#666666,color:#202020
