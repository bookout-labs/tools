flowchart TD
    n0(["Enter stage"]):::terminal
    n1(["Reviewer · Assess the complete current PR"]):::worker
    n2["Foreman · Post exact-head findings"]:::step
    n3["Foreman · Route by finding severity"]:::step
    n4["Continue to Implement stage"]:::stage
    n5(["Cancelled<br/>Reported on Project card"]):::terminal
    n6(["Run stops<br/>Reported on Project card"]):::terminal
    n7["Continue to Merge stage"]:::stage
    n8{{"Human<br/>• Resolve scope or rule<br/>• Decide or cancel<br/>• Resume review"}}:::gate
    n0 --> n1
    n1 -->|"PR revision changed"| n4
    n1 --> n5
    n1 --> n6
    n1 -->|"Assessed"| n2
    n2 -->|"PR revision changed"| n4
    n2 --> n6
    n2 -->|"Posted"| n3
    n3 --> n6
    n3 -->|"Critical defect / Serious defect"| n4
    n3 -->|"No blocking finding"| n7
    n1 -.->|"Unresolved choice"| n8
    n8 -.-> n1
    classDef stage fill:#dcebf8,stroke:#315675,color:#10283b
    classDef step fill:#edf3f8,stroke:#597187,color:#132638
    classDef worker fill:#d7f0e8,stroke:#357369,color:#133c36
    classDef gate fill:#fff0c9,stroke:#89641f,color:#3f2b0b
    classDef terminal fill:#f0f0f0,stroke:#666666,color:#202020
