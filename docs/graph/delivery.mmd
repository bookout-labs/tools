---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	triage(triage)
	research(research)
	spec(spec)
	implement(implement)
	review(review)
	verify(verify)
	prepare(prepare)
	reconcile(reconcile)
	size(size)
	commit(commit)
	publish(publish)
	review_post(review_post)
	needs_human(needs_human)
	decide_pr_size(decide_pr_size)
	merge(merge)
	done(done)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> done;
	__start__ -.-> triage;
	commit -.-> done;
	commit -.-> verify;
	decide_pr_size -.-> done;
	decide_pr_size -.-> size;
	implement -.-> done;
	implement -.-> reconcile;
	merge --> done;
	needs_human -.-> done;
	needs_human -.-> review;
	needs_human -.-> spec;
	needs_human -.-> triage;
	prepare -.-> done;
	prepare -.-> implement;
	publish -.-> done;
	publish -.-> review;
	reconcile -.-> done;
	reconcile -.-> size;
	research -.-> done;
	review -.-> done;
	review -.-> merge;
	review -.-> needs_human;
	review -.-> prepare;
	review -.-> review_post;
	review_post -.-> done;
	review_post -.-> merge;
	review_post -.-> needs_human;
	review_post -.-> prepare;
	size -. &nbsp;fits&nbsp; .-> commit;
	size -.-> decide_pr_size;
	size -. &nbsp;too big: re-plan&nbsp; .-> spec;
	spec -.-> decide_pr_size;
	spec -.-> done;
	spec -.-> needs_human;
	spec -.-> prepare;
	triage -.-> done;
	triage -.-> needs_human;
	triage -.-> research;
	triage -.-> spec;
	verify -.-> done;
	verify -.-> prepare;
	verify -.-> publish;
	done --> __end__;
	spec -.-> spec;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
